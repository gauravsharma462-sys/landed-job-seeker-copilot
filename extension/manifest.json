{
  "manifest_version": 3,
  "name": "Fill with Landed — Direct Desktop Apply & LinkedIn Bridge",
  "version": "1.2.0",
  "description": "Direct browser automation bridge for Landed. Eliminates chat-scheduled queues: triggers LinkedIn Recommended imports and Desktop Apply autofill immediately while keeping you in control of the final Submit button.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://*.indeed.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.greenhouse.io/*",
    "https://*.lever.co/*",
    "http://localhost:*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*",
        "https://*.indeed.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "http://localhost:*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
